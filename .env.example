# Copy to `.env` to change any of these.
# Every value already has the same default inside docker-compose.yml.
# `.env` is entirely optional - `docker compose up -d` works without it.

# Image coordinates. Override both to run a locally built image instead of the
# published one, e.g. IMAGE=app-assignment-backend with IMAGE_TAG=dev.
IMAGE=ghcr.io/titin-fanon/app-assignment-backend
IMAGE_TAG=1.0.1

# Host ports. These move only the host side of the mapping; inside the containers the servers always listen on 3001 and 3002.
# Change these if something else on your machine already owns 3001/3002.
API_PORT=3001
MCP_PORT=3002

# Applies to both services. One of: debug, info, warn, error.
LOG_LEVEL=info

# Optional: inject artificial latency (ms) into every API response.
# Useful for exercising loading and skeleton states. 0 disables.
# GET /health is exempt, so a large value here will not mark the container unhealthy.
LATENCY_MS=0
